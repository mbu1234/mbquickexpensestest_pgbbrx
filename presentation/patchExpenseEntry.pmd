{
  "id": "patchExpenseEntry",
  "endPoints": [
    {
      "name": "getCurrencies",
      "baseUrlType": "COMMON",
      "url": "/currencies",
      "authType": "sso",
      "isCollection": true
    },
    {
      "name": "getExpenseEntry",
      "baseUrlType": "WORKDAY-EXPENSE",
      "url": "<% `/entries/{{queryParams.expenseEntryWID}}` %>",
      "authType": "sso"
    }
  ],
  "outboundData": {
    "outboundEndPoints": [
      {
        "name": "patchExpenseEntry",
        "baseUrlType": "WORKDAY-EXPENSE",
        "url": "<% `/entries/{{queryParams.expenseEntryWID}}` %>",
        "httpMethod": "PATCH",
        "onSend": "<%
           {
            'date': dateWidget.value.format('yyyy-MM-dd'),
            'memo': memoWidget.value,
            'merchant': merchantWidget.value,
            'amount': {
              'value': amountWidget.value,
              'currency': currencyWidget.value[0]
             }
           }
        %>"
      }
    ]
  },
  "presentation": {
    "title": {
      "type": "title",
      "label": "Workday Extend"
    },
    "body": {
      "type": "section",
      "horizontal": false,
      "children": [
        {
          "type": "date",
          "id": "dateWidget",
          "label": "Date",
          "value": "<% getExpenseEntry.date %>"
        },
        {
          "type": "text",
          "id": "memoWidget",
          "label": "Memo",
          "value": "<% getExpenseEntry.memo %>"
        },
        {
          "type": "text",
          "id": "merchantWidget",
          "label": "Merchant",
          "value": "<% getExpenseEntry.merchant %>"
        },
        {
          "type": "text",
          "id": "amountWidget",
          "label": "Amount",
          "value": "<% getExpenseEntry.amount.value %>"
        },
        {
          "type": "instanceList",
          "id": "currencyWidget",
          "label": "Currency",
          "values": "<% getCurrencies.data %>",
          "idKey": "code"
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "homePod"
        }
      ]
    }
  }
}