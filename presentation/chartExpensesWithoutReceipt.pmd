{
  "id": "chartExpensesWithoutReceipt",
  "endPoints": [
    {
      "name": "getExpenseEntries",
      "baseUrlType": "WORKDAY-EXPENSE",
      "url": "/entries",
      "authType": "sso",
      "isCollection": true
    }
  ],
  "presentation": {
    "title": {
      "type": "title",
      "label": "ExpensesWithoutReceipt"
    },
    "body": {
      "type": "section",
      "horizontal": false,
      "children": [
        {
          "type": "grid",
          "id": "allExpensesExpensed",
          "label": "Processed Expenses",
          "rows": "<% getExpenseEntries.data.filter(row => empty row.attachments) %>",
          "rowVariableName": "row",
          "columns": [
            {
              "type": "column",
              "columnId": "dateCol",
              "label": "Date",
              "sortableAndFilterable": true,
              "cellTemplate": {
                "type": "date",
                "id": "expDate",
                "value": "<% row.date %>"
              }
            },
            {
              "type": "column",
              "columnId": "categoryCol",
              "label": "Category",
              "sortableAndFilterable": true,
              "cellTemplate": {
                "type": "text",
                "id": "expCategory",
                "value": "<% row.expenseItem.descriptor ?? '' %>"
              }
            },
            {
              "type": "column",
              "columnId": "memoCol",
              "label": "Memo",
              "sortableAndFilterable": true,
              "cellTemplate": {
                "type": "text",
                "id": "expMemo",
                "value": "<% row.memo %>"
              }
            },
            {
              "type": "column",
              "columnId": "amountCol",
              "label": "Amount",
              "sortableAndFilterable": true,
              "cellTemplate": {
                "type": "currency",
                "id": "expAmount",
                "currencyCode": "<% row.amount.currency %>",
                "value": "<% row.amount.value %>",
                "showCurrencySymbol": true,
                "fractionDigits": 2
              }
            },
            {
              "type": "column",
              "columnId": "merchantCol",
              "label": "Merchant",
              "sortableAndFilterable": true,
              "cellTemplate": {
                "type": "text",
                "id": "expMerchant",
                "value": "<% row.merchant %>"
              }
            },
            {
              "type": "column",
              "columnId": "entryStatusColId",
              "label": "Entry Status",
              "sortableAndFilterable": true,
              "cellTemplate": {
                "type": "text",
                "id": "expStatus",
                "value": "<% row.expenseEntryStatus.descriptor %>"
              }
            },
            {
              "type": "column",
              "columnId": "entryTypeColId",
              "label": "Entry Type",
              "sortableAndFilterable": true,
              "cellTemplate": {
                "type": "text",
                "id": "expType",
                "value": "<% row.entryType.descriptor %>"
              }
            },
            {
              "type": "column",
              "columnId": "entryReceiptCol",
              "label": "Receipt Attached?",
              "sortableAndFilterable": true,
              "cellTemplate": {
                "type": "text",
                "id": "expType",
                "value": "<% empty row.attachments ? 'No' : 'Yes'%>"
              }
            },
            {
              "type": "column",
              "columnId": "entryActionsCol",
              "label": "Actions",
              "cellTemplate": {
                "type": "section",
                "children": [
                  {
                    "type": "button",
                    "action": "AUXILIARY",
                    "label": "View",
                    "taskReference": {
                      "type": "taskReference",
                      "taskId": "getExpenseEntry",
                      "parameterBindings": {
                        "expenseEntryWID": "<% row.id %>"
                      }
                    }
                  },
                  {
                    "type": "button",
                    "action": "AUXILIARY",
                    "label": "Edit",
                    "render": "<% row.expenseEntryStatus.descriptor == 'New' %>",
                    "taskReference": {
                      "type": "taskReference",
                      "taskId": "patchExpenseEntry",
                      "parameterBindings": {
                        "expenseEntryWID": "<% row.id %>"
                      }
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "clusteredBarChart2",
          "categoryDataSet": {
            "name": "Category",
            "value": "<% data.expenseItem.descriptor ?? 'New' %>"
          },
          "data": "<% getExpenseEntries.data.filter(row => empty row.attachments) %>",
          "dataVariableName": "data",
          "measurementDataSets": [
            {
              "name": "Amount",
              "value": "<% data.amount.value %>"
            }
          ]
        }
      ]
    },
    "footer": {
      "type": "footer",
      "children": [
        {
          "type": "pod",
          "podId": "homePod"
        }
      ]
    }
  }
}